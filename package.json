{
  "name": "eraser-craft",
  "version": "0.1.1",
  "private": true,
  "description": "Eraser Craft : les ateliers de fabrication des personnages d'Eraser (Cuisine, Alchimie…), publiés comme extension.",
  "eraserExtension": {
    "id": "craft",
    "api": 5,
    "boot": "boot.js",
    "globalStyles": [
      "craft.css"
    ],
    "server": "server.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-types.mjs",
    "pack": "node scripts/pack-extension.mjs dist release",
    "release": "npm run build && npm run check && npm test && npm run pack",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@tailwindcss/cli": "4.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.25.12",
    "lucide-react": "1.31.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
